# Copy to .env.local and fill with your Firebase web app config.
VITE_FIREBASE_API_KEY=
# Prefer your Hosting host in production (e.g. freetail7s.web.app), not *.firebaseapp.com.
# On localhost the app auto-uses {projectId}.firebaseapp.com for the Auth helper.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=freetail7s
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set to "true" to talk to local emulators
VITE_USE_EMULATORS=false

# Force local demo auth even if Firebase keys are present
# VITE_USE_DEMO=true
